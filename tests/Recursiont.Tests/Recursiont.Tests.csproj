    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Recursiont\Recursiont.csproj" />
  </ItemGroup>
</Project>
